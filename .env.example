# Copy to .env and fill in. Never commit .env.

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Your identity (goes into every draft; must be accurate) --------------
# The demo ships with a fictional web studio. Replace all five with your own.
SENDER_NAME=Alex Morgan
SENDER_TITLE=Founder
SENDER_COMPANY=Tradie Web Co
SENDER_EMAIL=hello@tradiewebco.example
SENDER_WEBSITE=https://www.tradiewebco.example
# Optional: override the default opt-out sentence
# UNSUBSCRIBE_LINE=If you'd rather not hear from me again, just reply "no thanks".

# --- Zoho MCP -------------------------------------------------------------
# From https://www.zoho.com/mcp/ : create a server, add the Zoho Mail tools
# (create-draft at minimum), authorise via OAuth, copy the server URL.
ZOHO_MCP_URL=

# url_embedded   -> the key is already inside ZOHO_MCP_URL; leave the tokens blank.
#                   Note: a vault can only substitute secrets into request headers
#                   and bodies, never the URL, so this key is NOT vault-protected —
#                   it is stored in the agent config and readable back from the API.
# static_bearer  -> paste a long-lived token into ZOHO_ACCESS_TOKEN
# mcp_oauth      -> Anthropic refreshes for you; needs the refresh block too
ZOHO_AUTH_MODE=static_bearer
ZOHO_ACCESS_TOKEN=
ZOHO_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_TOKEN_ENDPOINT=https://accounts.zoho.com/oauth/v2/token
# ISO 8601, e.g. 2026-09-01T00:00:00Z (mcp_oauth only)
ZOHO_TOKEN_EXPIRES_AT=

# --- Optional data source -------------------------------------------------
# Free key: https://portal.api.business.govt.nz/  (official NZ business register)
NZBN_API_KEY=
